{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.7",
  "description": "An Electron-based desktop wrapper for deepseek-harness.",
  "author": "fellow99",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "typecheck": "tsc --noEmit",
    "build:dsh": "node scripts/build-dsh.mjs",
    "collect:dsh": "node scripts/collect-dsh.mjs",
    "fetch:runtime": "node scripts/fetch-runtime.mjs",
    "prepackage": "node scripts/collect-dsh.mjs && node scripts/fetch-runtime.mjs",
    "premake": "node scripts/collect-dsh.mjs && node scripts/fetch-runtime.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^24.0.0",
    "electron": "43.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  }
}
